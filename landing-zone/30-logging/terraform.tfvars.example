scope_type                 = "organization"
scope_id                   = "ORG_ID"
logging_project_id         = "PROJECT_PREFIX-logging-hub"
region                     = "europe-west1"
dataset_location           = "EU"
bucket_location            = "eu"
archive_bucket_name        = "PROJECT_PREFIX-audit-archive"
default_table_expiration_ms = 31536000000
retention_period_seconds   = 31536000
lock_retention             = false
log_bucket_retention_days  = 30

